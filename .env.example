# ==============================================================================
# MANUTCAR - VARIÁVEIS DE AMBIENTE (EXEMPLO)
# ==============================================================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env real.

# ------------------------------------------------------------------------------
# APLICAÇÃO GERAL
# ------------------------------------------------------------------------------
ENVIRONMENT=development
APP_TZ=America/Sao_Paulo
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# BANCO DE DADOS (NEON POSTGRESQL)
# ------------------------------------------------------------------------------
# Formato Pooled (PgBouncer) para Render/Vercel: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
# Formato Direto (psql local/migrações): postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://user:pass@localhost:5432/manutcar?sslmode=disable"
DATABASE_URL_UNPOOLED="postgresql://user:pass@localhost:5432/manutcar?sslmode=disable"

# ------------------------------------------------------------------------------
# AUTENTICAÇÃO (CLERK)
# ------------------------------------------------------------------------------
# Chaves obtidas no Dashboard Clerk -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="YOUR_CLERK_PUBLISHABLE_KEY_HERE"
CLERK_SECRET_KEY="YOUR_CLERK_SECRET_KEY_HERE"
CLERK_JWKS_URL="https://YOUR_CLERK_DOMAIN/.well-known/jwks.json"
CLERK_JWT_ISSUER="https://YOUR_CLERK_DOMAIN"
CLERK_JWT_AUDIENCE="" # Preencha se o JWT template definir uma audience
CLERK_WEBHOOK_SECRET="YOUR_CLERK_WEBHOOK_SECRET_HERE" # Obtido em Clerk -> Webhooks -> Signing Secret
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/onboarding"

# ------------------------------------------------------------------------------
# STORAGE (CLOUDFLARE R2)
# ------------------------------------------------------------------------------
# Obtido em Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
R2_ACCESS_KEY_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
R2_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
R2_BUCKET_NAME="manutcar-dev"
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev" # Opcional: URL pública se bucket for público

# ------------------------------------------------------------------------------
# E-MAIL (RESEND)
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="ManutCar <onboarding@resend.dev>" # Use domínio verificado em produção

# ------------------------------------------------------------------------------
# PUSH NOTIFICATIONS (FIREBASE FCM)
# ------------------------------------------------------------------------------
# Service Account JSON (Base64 encoded) ou caminho do arquivo
# Para gerar Base64: cat firebase-service-account.json | base64 -w 0
FCM_SERVICE_ACCOUNT_JSON_BASE64=""
# Chave VAPID para Web Push (Firebase Console -> Project Settings -> Cloud Messaging -> Web Push certificates)
NEXT_PUBLIC_FCM_VAPID_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ------------------------------------------------------------------------------
# URLs DA APLICAÇÃO
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:8000"
CORS_ORIGINS="http://localhost:3000,http://localhost:8000"

# ------------------------------------------------------------------------------
# CONFIGURAÇÕES INTERNAS (PYDANTIC SETTINGS)
# ------------------------------------------------------------------------------
# Chave secreta para JWT internos (se necessário além do Clerk), assinatura de cookies, etc.
# Gere com: openssl rand -hex 32
SECRET_KEY="your-super-secret-key-change-in-production-min-32-chars"
